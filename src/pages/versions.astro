---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Versions moved - Fossify"
  description="Fossify version and package details are available on the Releases page."
  canonicalPath="/updates/"
  noindex={true}
>
  <section class="page-hero compact-redirect-page">
    <div class="container prose">
      <p class="eyebrow">Page moved</p>
      <h1 class="page-title">Versions are now under Releases</h1>
      <p class="lead">
        The Releases page keeps versions, publication dates, package names, and
        source links in one place.
      </p>
      <div class="actions">
        <a class="button primary" href="/updates/">Open Releases</a>
        <a class="button subtle" href="/apps/">Browse apps</a>
      </div>
    </div>
  </section>
</BaseLayout>
