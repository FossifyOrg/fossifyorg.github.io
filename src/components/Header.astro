---
import { navItems, site } from "../data/site";

type Props = {
  currentPath: string;
};

const { currentPath } = Astro.props;
const sectionPath = (() => {
  if (currentPath.startsWith("/updates") || currentPath.startsWith("/versions"))
    return "/apps/";
  if (
    currentPath.startsWith("/faq") ||
    currentPath.startsWith("/policy") ||
    currentPath.startsWith("/privacy") ||
    currentPath.startsWith("/docs")
  )
    return "/support/";
  if (currentPath.startsWith("/translations")) return "/contribute/";
  if (currentPath.startsWith("/press")) return "/about/";
  return currentPath;
})();
const active = (href: string) =>
  href === "/" ? sectionPath === "/" : sectionPath.startsWith(href);
---

<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href="/" aria-label="Fossify home">
      <img src="/assets/brand/logo.webp" alt="" width="40" height="40" />
      <span>Fossify</span>
    </a>
    <nav class="nav" aria-label="Primary navigation">
      {
        navItems.map((item) => (
          <a
            href={item.href}
            aria-current={active(item.href) ? "page" : undefined}
          >
            {item.label}
          </a>
        ))
      }
      <a href={site.github}>GitHub</a>
    </nav>
    <details class="nav-menu">
      <summary>
        <span class="menu-icon" aria-hidden="true"></span>
        <span>Menu</span>
      </summary>
      <nav class="nav-menu-panel" aria-label="Mobile navigation">
        {
          navItems.map((item) => (
            <a
              href={item.href}
              aria-current={active(item.href) ? "page" : undefined}
            >
              {item.label}
            </a>
          ))
        }
        <a href={site.github}>GitHub</a>
      </nav>
    </details>
  </div>
</header>
