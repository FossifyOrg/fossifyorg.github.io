---
import { site } from "../data/site";

const footerGroups = [
  {
    title: "Apps",
    className: "footer-group-apps",
    links: [
      { label: "Apps", href: "/apps/" },
      { label: "Install", href: "/install/" },
      { label: "Releases", href: "/updates/" },
    ],
  },
  {
    title: "Help and privacy",
    className: "footer-group-help",
    links: [
      { label: "Help", href: "/support/" },
      { label: "FAQ", href: "/faq/" },
      { label: "App policies", href: "/policy/" },
      { label: "Website privacy", href: "/privacy/" },
    ],
  },
  {
    title: "Project",
    className: "footer-group-project",
    links: [
      { label: "Contribute", href: "/contribute/" },
      { label: "About", href: "/about/" },
      { label: "Fund", href: "/donate/" },
      { label: "Source", href: site.github },
      { label: "Translations", href: "/translations/" },
      { label: "Press kit", href: "/press/" },
    ],
  },
];
---

<footer class="site-footer">
  <div class="container footer-grid">
    <section class="footer-intro">
      <img
        class="footer-logo"
        src="/assets/brand/logo-horizontal.webp"
        alt="Fossify"
        width="150"
        height="63"
        loading="lazy"
      />
      <h2>Fossify for Android</h2>
      <p>
        Open-source Android apps for everyday phone tasks, without advertising
        or tracking.
      </p>
    </section>
    {
      footerGroups.map((group) => (
        <section class={`footer-group ${group.className}`}>
          <h3>{group.title}</h3>
          <ul>
            {group.links.map((link) => (
              <li>
                <a href={link.href}>{link.label}</a>
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </div>
  <div class="footer-bottom">
    <div class="container">Copyright 2026 Fossify.</div>
  </div>
</footer>
