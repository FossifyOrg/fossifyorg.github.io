---
import type { StoreLinks } from "../data/apps";

type Props = { links: StoreLinks };
const { links } = Astro.props;
---

<div class="store-links" aria-label="Install, source, and privacy links">
  {
    links.play && (
      <a
        class="store-link store-link-install store-link-play"
        href={links.play}
      >
        <svg aria-hidden="true" viewBox="0 0 24 24">
          <path d="M5 3.4v17.2L19.2 12 5 3.4Z" />
        </svg>
        <span>Google Play</span>
      </a>
    )
  }
  {
    links.fdroid && (
      <a
        class="store-link store-link-install store-link-fdroid"
        href={links.fdroid}
      >
        <svg aria-hidden="true" viewBox="0 0 24 24">
          <path d="M7.2 8.5h9.6a2 2 0 0 1 2 2v6.3a2 2 0 0 1-2 2H7.2a2 2 0 0 1-2-2v-6.3a2 2 0 0 1 2-2Z" />
          <path d="m8 4 2.2 4.5M16 4l-2.2 4.5" />
          <path d="M9 13h.1M15 13h.1" />
        </svg>
        <span>F-Droid</span>
      </a>
    )
  }
  <a class="store-link store-link-source" href={links.github}>
    <svg aria-hidden="true" viewBox="0 0 24 24">
      <path d="M7 18.5a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5Z"></path>
      <path d="M17 10.5a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5Z"></path>
      <path d="M7 13.5V9a3 3 0 0 1 3-3h4.5"></path>
    </svg>
    <span>Source code</span>
  </a>
  <a class="store-link store-link-quiet" href={links.policy}>
    <svg aria-hidden="true" viewBox="0 0 24 24">
      <path d="M12 3.5 18 6v5c0 4-2.4 7.2-6 9-3.6-1.8-6-5-6-9V6l6-2.5Z"></path>
    </svg>
    <span>Privacy policy</span>
  </a>
</div>
